---
import { render } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { formatDate, getPosts, readingTime, slugifyTag, type Post } from '../../utils';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post, i) => ({
    params: { slug: post.id },
    props: { post, newer: posts[i - 1], older: posts[i + 1] },
  }));
}

interface Props {
  post: Post;
  newer?: Post;
  older?: Post;
}

const { post, newer, older } = Astro.props;
const { title, description, pubDate, updatedDate, tags, image, imageAlt } = post.data;
const { Content } = await render(post);
---

<BaseLayout title={title} description={description} type="article" publishedTime={pubDate}>
  <article class="narrow">
    <header>
      <p class="meta">
        <time datetime={pubDate.toISOString()}>{formatDate(pubDate)}</time>
        <span aria-hidden="true">·</span>
        <span>{readingTime(post.body)}</span>
        {
          updatedDate && (
            <>
              <span aria-hidden="true">·</span>
              <span>
                Updated <time datetime={updatedDate.toISOString()}>{formatDate(updatedDate)}</time>
              </span>
            </>
          )
        }
      </p>
      <h1>{title}</h1>
      <p class="lede">{description}</p>
      {
        tags.length > 0 && (
          <p class="tags">
            {tags.map((t) => (
              <a class="tag" href={`/tags/${slugifyTag(t)}/`}>
                #{t}
              </a>
            ))}
          </p>
        )
      }
    </header>

    {
      image && (
        <Image
          class="cover"
          src={image}
          alt={imageAlt ?? ''}
          widths={[720, 1440]}
          sizes="(max-width: 48rem) 100vw, 48rem"
          loading="eager"
        />
      )
    }

    <div class="prose">
      <Content />
    </div>

    <nav class="pager" aria-label="More posts">
      {
        older ? (
          <a href={`/blog/${older.id}/`} class="prev">
            <span>← Older</span>
            {older.data.title}
          </a>
        ) : (
          <span />
        )
      }
      {
        newer && (
          <a href={`/blog/${newer.id}/`} class="next">
            <span>Newer →</span>
            {newer.data.title}
          </a>
        )
      }
    </nav>
  </article>
</BaseLayout>

<style>
  .cover {
    display: block;
    width: 100%;
    height: auto;
    margin: 0 0 2.5rem;
    border-radius: 0.5rem;
  }
  header {
    margin-bottom: 2.5rem;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid var(--border);
  }
  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 0 0 0.75rem;
    color: var(--text-muted);
    font-family: var(--font-mono);
    font-size: 0.85rem;
  }
  .lede {
    margin-bottom: 1rem;
  }
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin: 0;
  }
  .pager {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
    margin-top: 4rem;
  }
  .pager a {
    display: flex;
    flex-direction: column;
    padding: 1rem 1.25rem;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    color: var(--text);
    font-weight: 600;
    text-decoration: none;
  }
  .pager a:hover {
    border-color: var(--accent);
  }
  .pager span {
    color: var(--text-muted);
    font-family: var(--font-mono);
    font-size: 0.8rem;
    font-weight: 400;
  }
  .next {
    grid-column: 2;
    text-align: right;
  }
  @media (max-width: 34rem) {
    .pager {
      grid-template-columns: 1fr;
    }
    .next {
      grid-column: 1;
    }
  }
</style>
