---
import BaseLayout from '../layouts/BaseLayout.astro';

// Scraps of the site that spiral into the black hole. Each one gets its own
// start angle, speed and phase so the stream looks continuous and uneven.
const scraps = [
  '</>', '0', '{ }', '1', '.md', '#', '<p>', '0', '?', '1', 'px', '//', '0', '[ ]', '1',
  'NaN', 'f(x)', '.py', 'λ', 'null', '∑', '=>', '1', '<div>', 'π', 'git', '0', '∞', ';', 'ML', 'σ', '.css', '1', '&&', '∂',
];
const bits = scraps.map((text, i) => ({
  text,
  angle: (i * 137) % 360, // golden-angle spread
  duration: 3.2 + ((i * 7) % 5) * 0.45,
  delay: -((i * 0.83) % 5),
}));
---

<BaseLayout title="Not found" noindex>
  <section class="lost">
    <div class="big" role="img" aria-label="404, where the zero is a black hole swallowing bits of information">
      <span class="four" aria-hidden="true">4</span>
      <span class="hole" aria-hidden="true">
        <span class="plane">
          <span class="layer glow"></span>
          <span class="layer disk"></span>
          <span class="layer disk streaks"></span>
          {
            bits.map((b) => (
              <span class="layer orbit" style={`--a:${b.angle}deg;--d:${b.duration}s;--delay:${b.delay}s`}>
                <span class="bit">{b.text}</span>
              </span>
            ))
          }
          <span class="layer horizon"></span>
        </span>
      </span>
      <span class="four" aria-hidden="true">4</span>
    </div>

    <h1>This page fell into a black hole.</h1>
    <p class="lede">
      Whatever was at <code class="path">this URL</code> crossed the event horizon. It may have moved, or it never
      existed.
    </p>
    <p class="actions">
      <a href="/">Go home →</a>
      <a href="/blog">Read the blog →</a>
    </p>
  </section>
</BaseLayout>

<script is:inline>
  // Show the URL that was requested (GitHub Pages serves this page at the missing path).
  (() => {
    const el = document.querySelector('.path');
    if (el && location.pathname !== '/404.html') el.textContent = decodeURI(location.pathname);
  })();
</script>

<style>
  .lost {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    /* Orbiting bits can poke past the edge on very narrow screens. */
    overflow-x: clip;
  }

  /* ---------- 4 [hole] 4 ---------- */
  .big {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.02em;
    margin: 0 0 1.5rem;
    font-size: clamp(6.5rem, 26vw, 12rem);
    font-weight: 800;
    line-height: 1;
    letter-spacing: -0.04em;
    user-select: none;
  }
  .four {
    color: var(--text);
  }

  /* The zero: a square box whose contents are squashed into the oval of a digit,
     so the circular disk reads as an accretion disk seen at an angle. */
  .hole {
    position: relative;
    width: 0.74em;
    height: 0.9em;
    margin-inline: 0.04em;
  }
  .plane {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 0.9em;
    height: 0.9em;
    margin: -0.45em 0 0 -0.45em;
    transform: scaleX(0.82);
  }
  .layer {
    position: absolute;
    inset: 0;
    border-radius: 50%;
  }

  /* Soft heat haze behind the disk. */
  .glow {
    inset: -6%;
    background: radial-gradient(circle closest-side, transparent 60%, color-mix(in srgb, var(--accent) 40%, transparent) 85%, transparent 100%);
    filter: blur(5px);
    animation: breathe 4s ease-in-out infinite;
  }

  /* Accretion disk: a ring of hot gas, uneven so the rotation is visible. */
  .disk {
    background: conic-gradient(
      from 0deg,
      var(--accent) 0deg,
      var(--hot) 50deg,
      var(--accent) 110deg,
      var(--deep) 170deg,
      var(--accent) 220deg,
      var(--hot) 280deg,
      var(--deep) 330deg,
      var(--accent) 360deg
    );
    mask: radial-gradient(circle closest-side, transparent 50%, #000 54%, #000 90%, transparent 99%);
    animation: spin 6s linear infinite;
  }
  .streaks {
    background: repeating-conic-gradient(from 10deg, transparent 0deg 14deg, color-mix(in srgb, var(--hot) 70%, transparent) 16deg 18deg, transparent 20deg 31deg);
    mask: radial-gradient(circle closest-side, transparent 55%, #000 60%, #000 85%, transparent 95%);
    opacity: 0.8;
    animation: spin 3.5s linear infinite;
  }

  /* Event horizon, with a thin photon ring at its edge. */
  .horizon {
    inset: 24%;
    background: #000;
    box-shadow:
      0 0 0 1.5px var(--hot),
      0 0 10px 2px color-mix(in srgb, var(--accent) 70%, transparent),
      inset 0 0 12px #000;
  }

  /* Bits: the orbit rotates while the bit slides inward, which traces a spiral. */
  .orbit {
    border-radius: 0;
    transform: rotate(var(--a));
    animation: orbit var(--d) linear infinite;
    animation-delay: var(--delay);
  }
  .bit {
    position: absolute;
    top: 50%;
    left: 50%;
    font-family: var(--font-mono);
    font-size: 0.075em;
    font-weight: 600;
    letter-spacing: 0;
    line-height: 1;
    color: var(--text);
    white-space: nowrap;
    animation: fall var(--d) cubic-bezier(0.55, 0, 0.85, 0.4) infinite;
    animation-delay: var(--delay);
  }

  @keyframes spin {
    to {
      transform: rotate(-360deg);
    }
  }
  @keyframes orbit {
    from {
      transform: rotate(var(--a));
    }
    to {
      transform: rotate(calc(var(--a) - 540deg));
    }
  }
  @keyframes fall {
    0% {
      transform: translate(-50%, -50%) translateX(7.5em) scale(1);
      opacity: 0;
    }
    12% {
      opacity: 1;
    }
    75% {
      color: var(--hot);
      opacity: 1;
    }
    100% {
      transform: translate(-50%, -50%) translateX(2.4em) scale(0.15, 0.05);
      color: var(--accent);
      opacity: 0;
    }
  }
  @keyframes breathe {
    50% {
      opacity: 0.6;
      transform: scale(1.04);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .plane *,
    .plane {
      animation: none !important;
    }
    .orbit {
      display: none;
    }
  }

  /* ---------- text ---------- */
  h1 {
    max-width: 22ch;
  }
  .lede {
    max-width: 34rem;
    margin-bottom: 1.5rem;
  }
  .path {
    padding: 0.1em 0.35em;
    border: 1px solid var(--border);
    border-radius: 0.3rem;
    background: var(--code-bg);
    color: var(--text);
    font-family: var(--font-mono);
    font-size: 0.85em;
    word-break: break-all;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 1.5rem;
    margin: 0;
  }

  /* A brighter, whiter tone of the accent for the hottest parts of the disk. */
  .lost {
    --hot: color-mix(in srgb, var(--accent) 45%, #ffd88a);
    --deep: color-mix(in srgb, var(--accent) 60%, #3a0800);
  }
</style>
