---
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { SITE } from '../consts';

interface Props {
  title?: string;
  description?: string;
  type?: 'website' | 'article';
  publishedTime?: Date;
  // Keep the page out of search results and skip the canonical URL (e.g. the 404 page,
  // which is served at whatever URL was missing).
  noindex?: boolean;
  // Social preview image (e.g. a post's cover). Without one, the avatar is used on a small card.
  image?: ImageMetadata;
  imageAlt?: string;
}

const {
  title,
  description = SITE.description,
  type = 'website',
  publishedTime,
  noindex = false,
  image,
  imageAlt,
} = Astro.props;
const fullTitle = title ? `${title} · ${SITE.title}` : SITE.title;
const canonical = new URL(Astro.url.pathname, Astro.site);

// Social cards are 1.91:1. Centre-crop the cover to that ratio without upscaling it.
const OG_RATIO = 1.91;
let ogImage: { src: string; width?: number; height?: number } = { src: SITE.avatar };
if (image) {
  const height = Math.min(image.height, Math.round(image.width / OG_RATIO));
  const width = Math.round(height * OG_RATIO);
  const cropped = await getImage({ src: image, width, height, fit: 'cover', format: 'jpg' });
  ogImage = { src: new URL(cropped.src, Astro.site).href, width, height };
}
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="sitemap" href="/sitemap-index.xml" />
<link rel="alternate" type="application/rss+xml" title={SITE.title} href={new URL('rss.xml', Astro.site)} />
{noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
<meta name="generator" content={Astro.generator} />

<title>{fullTitle}</title>
<meta name="title" content={fullTitle} />
<meta name="description" content={description} />
<meta name="author" content={SITE.author} />

<meta property="og:type" content={type} />
{!noindex && <meta property="og:url" content={canonical} />}
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:site_name" content={SITE.title} />
{publishedTime && <meta property="article:published_time" content={publishedTime.toISOString()} />}
<meta property="og:image" content={ogImage.src} />
{ogImage.width && <meta property="og:image:width" content={String(ogImage.width)} />}
{ogImage.height && <meta property="og:image:height" content={String(ogImage.height)} />}
{image && imageAlt && <meta property="og:image:alt" content={imageAlt} />}
<meta name="twitter:card" content={image ? 'summary_large_image' : 'summary'} />

<meta name="color-scheme" content="light dark" />
<script is:inline>
  (() => {
    let theme;
    try { theme = localStorage.getItem('theme'); } catch {}
    if (theme !== 'light' && theme !== 'dark') {
      theme = matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
    }
    document.documentElement.dataset.theme = theme;
  })();
</script>
