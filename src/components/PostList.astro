---
import type { Post } from '../utils';
import { formatDate } from '../utils';
import { Image } from 'astro:assets';

interface Props {
  posts: Post[];
}
const { posts } = Astro.props;
---

<ul class="post-list">
  {
    posts.map((post) => (
      <li>
        <a href={`/blog/${post.id}/`}>
          <time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate)}</time>
          <span class="title">
            {post.data.title}
            {post.data.draft && <span class="draft">draft</span>}
          </span>
          <span class="desc">{post.data.description}</span>
          {post.data.image && (
            <Image
              class="thumb"
              src={post.data.image}
              alt={post.data.imageAlt ?? ''}
              widths={[192, 384]}
              sizes="192px"
              loading="lazy"
            />
          )}
        </a>
      </li>
    ))
  }
</ul>

<style>
  .post-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  a {
    display: grid;
    grid-template-columns: 7.5rem 1fr auto;
    column-gap: 1.5rem;
    padding: 1rem 0;
    border-top: 1px solid var(--border);
    color: inherit;
    text-decoration: none;
  }
  li:last-child a {
    border-bottom: 1px solid var(--border);
  }
  time {
    grid-row: span 2;
    padding-top: 0.15rem;
    color: var(--text-muted);
    font-family: var(--font-mono);
    font-size: 0.85rem;
  }
  .title,
  .desc {
    grid-column: 2;
  }
  .thumb {
    grid-column: 3;
    grid-row: 1 / span 2;
    align-self: center;
    width: 8rem;
    height: 5rem;
    margin-left: 1rem;
    object-fit: cover;
    border-radius: 0.4rem;
    border: 1px solid var(--border);
  }
  .title {
    font-weight: 600;
    font-size: 1.1rem;
    transition: color 0.15s;
  }
  a:hover .title {
    color: var(--accent);
  }
  .desc {
    color: var(--text-muted);
    font-size: 0.95rem;
  }
  .draft {
    margin-left: 0.5rem;
    padding: 0 0.4rem;
    border-radius: 0.3rem;
    background: var(--accent-soft);
    color: var(--accent);
    font-family: var(--font-mono);
    font-size: 0.7rem;
    vertical-align: middle;
  }
  @media (max-width: 34rem) {
    a {
      grid-template-columns: 1fr;
    }
    time,
    .title,
    .desc {
      grid-column: 1;
      grid-row: auto;
    }
    .thumb {
      grid-column: 1;
      grid-row: 1;
      width: 100%;
      height: auto;
      aspect-ratio: 16 / 9;
      margin: 0 0 0.75rem;
    }
  }
</style>
